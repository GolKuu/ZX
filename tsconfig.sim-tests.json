{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".sim-test-build",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/sim/**/*.ts",
    "src/ai/**/*.ts",
    "src/hud/**/*.ts",
    "src/input/mobile-controller.ts",
    "src/input/attack-gate.ts",
    "src/input/bindings.ts",
    "src/input/bindingMigration.ts",
    "src/input/buffer.ts",
    "src/input/motion.ts",
    "src/input/command.ts",
    "src/input/core.ts",
    "src/input/profiles.ts",
    "src/input/lucky/**/*.ts",
    "src/input/sharedCommands.ts",
    "src/game/attackInputPolicy.ts",
    "src/game/CinematicFreeze.ts",
    "src/data/combat-moves.ts",
    "src/data/meter-moves.ts",
    "src/data/move-kind.ts",
    "src/data/taunt-move.ts",
    "src/data/glitch-combat-moves.ts",
    "src/data/glitch-super-moves.ts",
    "src/data/glitch/**/*.ts",
    "src/data/glitch-ai.ts",
    "src/data/lucky/**/*.ts",
    "src/data/titan/**/*.ts",
    "src/data/vorgh/**/*.ts",
    "src/data/mim-moves.ts",
    "src/data/mim-super-moves.ts",
    "src/input/glitchCommands.ts",
    "src/input/luckyCommands.ts",
    "src/input/titanCommands.ts",
    "src/input/vorghCommands.ts",
    "src/input/mimCommands.ts",
    "src/stage/model/humanoidBones.ts",
    "src/stage/fighterPresentation.ts",
    "src/stage/vorgh/vorghAnimationData.ts",
    "src/stage/vorgh/VorghAnimationController.ts",
    "src/stage/vorgh/vorghPose.ts",
    "src/stage/mim/mimSpritePose.ts",
    "src/stage/mim/mimSpriteTimeline.ts",
    "src/stage/sprite2d/spriteAttackTimeline.ts",
    "src/stage/sprite2d/spritePose.ts",
    "src/data/combat-ai.ts"
  ]
}
