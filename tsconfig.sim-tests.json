{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".sim-test-build",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/sim/**/*.ts",
    "src/ai/**/*.ts",
    "src/hud/**/*.ts",
    "src/input/mobile-controller.ts",
    "src/input/attack-gate.ts",
    "src/input/bindings.ts",
    "src/input/buffer.ts",
    "src/input/motion.ts",
    "src/input/command.ts",
    "src/input/core.ts",
    "src/game/attackInputPolicy.ts",
    "src/data/combat-moves.ts",
    "src/data/combat-ai.ts"
  ]
}
