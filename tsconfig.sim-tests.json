{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".sim-test-build",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/sim/**/*.ts", "src/data/combat-moves.ts"]
}
