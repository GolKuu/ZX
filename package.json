{
  "name": "circle-clash-ultimate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run lint && npm run typecheck && npm test && npm run assets:check",
    "postbuild": "npm run bundle:check",
    "analyze": "node scripts/analyze-bundle.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:combat && node --test scripts/keep-awake-utils.test.mjs",
    "test:combat": "tsc -p tsconfig.sim-tests.json && node --test tests/*.test.mjs",
    "verify": "npm run build && npm audit --audit-level=high",
    "start": "next start",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "keep-awake:setup": "node scripts/setup-keep-awake.mjs",
    "ai:secret": "node scripts/setup-ai-secret.mjs",
    "ai:deploy": "supabase functions deploy ai"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@supabase/supabase-js": "2.111.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "15.5.22",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/bundle-analyzer": "15.5.9",
    "@next/eslint-plugin-next": "15.5.22",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
