{
  "name": "nfact-teens-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:db": "supabase test db supabase/tests/database --linked",
    "test:remote": "node scripts/test-remote-account.mjs",
    "test:watch": "vitest",
    "match:dev": "npm --prefix match-server run dev",
    "match:build": "npm --prefix match-server run build",
    "match:test": "npm --prefix match-server test",
    "preview": "vite preview",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "keep-awake:setup": "node scripts/setup-keep-awake.mjs",
    "ai:secret": "node scripts/setup-ai-secret.mjs",
    "ai:deploy": "supabase functions deploy ai"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
